{
  "name": "entropy-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "tsc -b && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "test:inquiry": "node --experimental-strip-types --test tests/inquiry.test.mjs",
    "test:scenes": "node --experimental-strip-types --test tests/sceneGeometry.test.mjs",
    "models:export": "node --experimental-strip-types scripts/export-scenes.mjs"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "lenis": "^1.1.18",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "wrangler": "^4.144.0"
  }
}
